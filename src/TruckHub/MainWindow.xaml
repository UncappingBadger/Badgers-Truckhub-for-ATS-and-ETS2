<Window x:Class="TruckHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:TruckHub.Converters"
        Title="TruckHub v1.0"
        Width="300" Height="330"
        MinWidth="260" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Hides via Visibility.Hidden (keeps layout space reserved) rather than Collapsed, so rows
             that toggle don't change the card's aspect ratio and make the Viewbox rescale everything -
             which reads as the whole window "resizing" even though the actual window bounds don't move. -->
        <conv:BoolToHiddenConverter x:Key="BoolToHidden" />
    </Window.Resources>

    <Grid>
        <!-- Viewbox scales the whole card (fonts, sign, everything) uniformly to fill however
             big/small the window is resized to, instead of just leaving blank space around it. -->
        <Viewbox Stretch="Uniform">
        <Grid>
        <Border Background="#E6161616" CornerRadius="10" BorderBrush="#404040" BorderThickness="1"
                Width="300">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="TRUCKHUB · v1.0" Foreground="#888888" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1" Content="⚙" Click="Settings_Click"
                        Width="20" Height="20" Padding="0" Margin="0,0,6,0" FontSize="11" Background="#2A2A2A"
                        Foreground="White" BorderThickness="0" ToolTip="Settings" />

                <Button Grid.Column="2" Content="⛶" Click="Fullscreen_Click"
                        Width="20" Height="20" Padding="0" Margin="0,0,6,0" FontSize="11" Background="#2A2A2A"
                        Foreground="White" BorderThickness="0" ToolTip="Toggle fullscreen" />

                <Button Grid.Column="3" Content="✕" Click="Close_Click"
                        Width="20" Height="20" FontSize="10" Background="#2A2A2A"
                        Foreground="White" BorderThickness="0" />
            </Grid>

            <!-- Speed limit sign, centered alone, with turn signal arrows either side. The arrows
                 bind straight to the game's own current bulb state (BlinkerLeftOn/RightOn), which
                 already toggles at the real blink rate - hazards flash both together for free since
                 they drive the same two fields, no timer needed on our side. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10"
                        Visibility="{Binding SpeedSectionVisibility}">

                <Viewbox Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Polygon Points="16,4 16,20 4,12" Fill="{Binding TurnSignalLeftColor}" />
                </Viewbox>

                <!-- Fixed-width slot so whichever sign renders (American rectangle, European
                     circle, or the placeholder) is centered within the same footprint - letting
                     each one size itself and re-center the row shifted everything sideways whenever
                     the sign type changed. -->
                <Grid Width="86">
                    <!-- US-style speed limit sign (ATS) -->
                    <Border Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="6"
                            Padding="4,6" HorizontalAlignment="Center"
                            Visibility="{Binding ShowAmericanSpeedSign, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SPEED" Foreground="Black" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="LIMIT" Foreground="Black" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,-2,0,2" />
                            <TextBlock Text="{Binding SpeedLimitValue}" Foreground="Black" FontWeight="Bold"
                                       FontSize="30" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- European round sign (ETS2): white disc, red ring, black number, no text -->
                    <Border Background="White" BorderBrush="#CC0000" BorderThickness="6" CornerRadius="32"
                            Width="65" Height="65" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEuropeanSpeedSign, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SpeedLimitValue}" Foreground="Black" FontWeight="Bold"
                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" CornerRadius="6"
                            Padding="4,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowSpeedPlaceholder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="--" Foreground="#666666" FontWeight="Bold" FontSize="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Viewbox Width="26" Height="26" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Polygon Points="8,4 8,20 20,12" Fill="{Binding TurnSignalRightColor}" />
                </Viewbox>
            </StackPanel>

            <!-- Lights status: informational, not fault-colored - dimmed grey when off, lit in each
                 light's real dashboard telltale color when on (blue for high beam is the near-
                 universal convention; green for sidelights/low beam, matching most real clusters;
                 amber for the beacon, matching its actual light color; parking brake reuses the same
                 neutral-white-when-engaged treatment as its old standalone box). Grouped with the
                 turn signals above since both are "lights", not vehicle-fault telemetry like the
                 warning cluster below. -->
            <Border Grid.Row="2" Background="#202020" CornerRadius="6" Margin="0,0,0,10" Padding="10,7"
                    Visibility="{Binding LightsStatusVisibility}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Parking brake: a status, not a fault - lit neutral white when engaged, dimmed
                         off. The emergency-brake-from-low-air warning stays a separate telltale in
                         the warning cluster below since that one IS a fault. -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Parking brake" Visibility="{Binding ParkingBrakeVisibility}">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding ParkingBrakeColor}" StrokeThickness="2" />
                            <TextBlock Text="P" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{Binding ParkingBrakeColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Sidelights: lamp only, no beam -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Sidelights">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="6"
                                     Stroke="{Binding SidelightsColor}" StrokeThickness="1.6" />
                            <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10"
                                     Fill="{Binding SidelightsColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low beam: lamp + downward-angled beams -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low beam">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="7" Canvas.Left="2" Canvas.Top="8"
                                     Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="9" X2="20" Y2="6" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="11.5" X2="21" Y2="11.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="14" X2="20" Y2="17" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- High beam: same lamp, straight/parallel beams instead of angled -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="High beam">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="7" Canvas.Left="2" Canvas.Top="8"
                                     Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="7" X2="21" Y2="7" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="11.5" X2="21" Y2="11.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="16" X2="21" Y2="16" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Beacon: dome + radiating rays -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Beacon">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,16 A4,4 0 0 1 16,16 Z" Fill="{Binding BeaconColor}" />
                            <Line X1="12" Y1="16" X2="12" Y2="19" Stroke="{Binding BeaconColor}" StrokeThickness="1.6" />
                            <Line X1="4" Y1="10" X2="6.5" Y2="12.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                            <Line X1="20" Y1="10" X2="17.5" Y2="12.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                            <Line X1="12" Y1="5" X2="12" Y2="8" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                        </Canvas>
                    </Viewbox>

                    <!-- Differential lock: padlock -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Differential lock">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,11 L8,8 A4,4 0 0 1 16,8 L16,11" Fill="Transparent"
                                  Stroke="{Binding DiffLockColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="6" Canvas.Top="11" Width="12" Height="9" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{Binding DiffLockColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Lift/tag axle: wheel + up-arrow. Only shown if this truck actually has one
                         (see HasLiftAxle). Dimmed = down (normal, full axle load); lit = up (lifted). -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Lift/tag axle"
                             Visibility="{Binding HasLiftAxle, Converter={StaticResource BoolToVis}}">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="11"
                                     Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="12" Y1="3" X2="12" Y2="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="9" Y1="6" X2="12" Y2="3" StrokeStartLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="15" Y1="6" X2="12" Y2="3" StrokeStartLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- Warnings: individual telltales like a real instrument cluster - each mirrors the SDK's
                 own dashboard warning-light booleans (no thresholds of our own), dimmed grey until its
                 condition trips, then lights up in real dashboard colors (red = safety-critical,
                 amber = needs attention soon). Grouped with the Lights row above (both "cluster"
                 style icon strips), ahead of the trip-computer info below, since warnings are the
                 most urgent thing to see. -->
            <Border Grid.Row="3" Background="#202020" CornerRadius="6" Margin="0,0,0,10" Padding="10,7"
                    Visibility="{Binding WarningsVisibility}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Low air pressure: circle + "!" (SAE/ISO air-brake warning symbol) -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low air pressure">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                     Stroke="{Binding AirPressureWarnColor}" StrokeThickness="2" />
                            <Line X1="12" Y1="6" X2="12" Y2="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding AirPressureWarnColor}" StrokeThickness="2" />
                            <Ellipse Width="2" Height="2" Canvas.Left="11" Canvas.Top="16"
                                     Fill="{Binding AirPressureWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Parking brake (auto-applied on critically low air): circle + "P" -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Emergency / parking brake">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding ParkingBrakeWarnColor}" StrokeThickness="2" />
                            <TextBlock Text="P" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{Binding ParkingBrakeWarnColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Oil pressure: oil can + drip -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Oil pressure">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="11" Height="8" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding OilPressureWarnColor}" StrokeThickness="1.6" />
                            <Line X1="15" Y1="11" X2="19" Y2="7" StrokeStartLineCap="Round"
                                  Stroke="{Binding OilPressureWarnColor}" StrokeThickness="1.6" />
                            <Ellipse Width="3" Height="3" Canvas.Left="18.5" Canvas.Top="3.5"
                                     Fill="{Binding OilPressureWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Water temperature: thermometer -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Engine temperature">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="4" Height="13" RadiusX="2" RadiusY="2"
                                       Stroke="{Binding WaterTempWarnColor}" StrokeThickness="1.6" />
                            <Ellipse Width="8" Height="8" Canvas.Left="8" Canvas.Top="14"
                                     Stroke="{Binding WaterTempWarnColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low fuel: pump body + hose/nozzle -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low fuel">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="7" Width="9" Height="13" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="5" Height="3"
                                       Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                            <Path Data="M13,10 L18,10 L18,16 A2,2 0 0 1 16,18" Fill="Transparent"
                                  Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low AdBlue: droplet -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low AdBlue">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 C12,3 6,11 6,15 A6,6 0 1 0 18,15 C18,11 12,3 12,3 Z"
                                  Fill="{Binding AdBlueWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Battery / charging system -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Battery / charging system">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="8" Width="16" Height="10" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding BatteryWarnColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="8" Canvas.Top="5" Width="3" Height="3" Fill="{Binding BatteryWarnColor}" />
                            <Rectangle Canvas.Left="13" Canvas.Top="5" Width="3" Height="3" Fill="{Binding BatteryWarnColor}" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- Current speed (ring fills clockwise like a speedo, green/amber/red vs the limit) +
                 cruise control, side by side -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10"
                        Visibility="{Binding SpeedSectionVisibility}">

                <!-- All four boxes in this row and the next (Speed, Cruise, Gear, RPM) share this
                     exact 78x78 footprint so they line up as a uniform row instead of each sizing
                     to its own content. -->
                <Border Background="#202020" CornerRadius="6" Width="78" Height="78">
                    <Grid Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="#3A3A3A" StrokeThickness="5" />
                        <Path Width="70" Height="70" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{Binding SpeedRingArcData}" Stroke="{Binding SpeedColor}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SpeedValue}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding SpeedColor}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding UnitLabel}" FontSize="9" Foreground="#888888"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cruise control: icon + set speed both lit green when engaged, dimmed grey when off -->
                <Border Background="#202020" CornerRadius="6" Width="78" Height="78" Margin="10,0,0,0"
                        Visibility="{Binding CruiseControlVisibility}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                         Stroke="{Binding CruiseControlColor}" StrokeThickness="2" />
                                <Line X1="12" Y1="12" X2="17" Y2="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding CruiseControlColor}" StrokeThickness="2" />
                                <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10"
                                         Fill="{Binding CruiseControlColor}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding CruiseControlDisplay}" FontSize="15" FontWeight="Bold"
                                   Foreground="{Binding CruiseControlColor}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Gear + RPM: always shown once connected, independent of whether a job is active -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10"
                        Visibility="{Binding GearRpmSectionVisibility}">

                <Border Background="#202020" CornerRadius="6" Width="78" Height="78">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="GEAR" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding GearDisplay}" Foreground="White" FontSize="26"
                                   FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#202020" CornerRadius="6" Width="78" Height="78" Margin="10,0,0,0">
                    <Grid Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="#3A3A3A" StrokeThickness="5" />
                        <Path Width="70" Height="70" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{Binding RpmRingArcData}" Stroke="{Binding RpmColor}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RpmDisplay}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding RpmColor}" HorizontalAlignment="Center" />
                            <TextBlock Text="RPM" FontSize="9" Foreground="#888888" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Status / Job panel -->
            <Grid Grid.Row="6">

                <TextBlock Text="{Binding StatusMessage}" Foreground="#999999" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToHidden}}" />

                <StackPanel Visibility="{Binding ShowJobPanel, Converter={StaticResource BoolToHidden}}">
                    <TextBlock Text="{Binding RouteDisplay}" Foreground="White" FontSize="13"
                               FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Stretch" Visibility="{Binding RouteVisibility}" />

                    <TextBlock Text="{Binding CargoDisplay}" Foreground="#AAAAAA" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               Visibility="{Binding CargoVisibility}" />

                    <!-- Horizontal StackPanel (not a Grid) so that if any of these three are
                         disabled, the row re-centers around whatever's left instead of leaving a
                         blank gap. Each box shares the same fixed height so the row lines up evenly
                         regardless of how many lines its own content needs. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Border Background="#202020" CornerRadius="6" Height="72" Padding="8,8" Margin="0,0,8,0"
                                Visibility="{Binding PayoutVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PAYOUT" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding IncomeDisplay}" Foreground="#5FD85F" FontSize="17"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PricePerDistanceDisplay}" Foreground="#AAAAAA" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#202020" CornerRadius="6" Height="72" Padding="8,8" Margin="0,0,8,0"
                                Visibility="{Binding DistanceVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="DISTANCE" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DistanceTraveledDisplay}" Foreground="White" FontSize="17"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="11">
                                    <Run Text="of " /><Run Text="{Binding DistanceTotalDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#202020" CornerRadius="6" Height="72" Padding="8,8"
                                Visibility="{Binding TimeLeftVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TIME LEFT" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingTimeDisplay}" Foreground="White" FontSize="17"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Fuel: always shown once connected, independent of whether a job is active -->
            <Border Grid.Row="7" Background="#202020" CornerRadius="6" Margin="0,10,0,0" Padding="10,7"
                    Visibility="{Binding FuelSectionVisibility}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="FUEL" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FuelDisplay}" Foreground="White" FontSize="15"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,6,0,0" Visibility="{Binding AdBlueVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ADBLUE" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AdBlueDisplay}" Foreground="White" FontSize="15"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,6,0,0" Visibility="{Binding TripFuelForecastVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TRIP NEEDS" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FuelForecastDisplay}" Foreground="{Binding TripFuelColor}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,6,0,0" Visibility="{Binding FuelEconomyVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ECONOMY" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FuelEconomyDisplay}" Foreground="White" FontSize="15"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <!-- Manual resize grip: WindowStyle=None + AllowsTransparency windows get no OS resize border,
             so dragging this triggers the standard native resize loop via WM_SYSCOMMAND/SC_SIZE.
             Anchored inside the same Grid as the card (inside the Viewbox) so it tracks the card's
             actual visible corner - anchoring it to the outer Window bounds instead let it drift into
             the Viewbox's transparent letterbox padding whenever the window's aspect ratio didn't
             match the card's, leaving the grip visually detached from the card. -->
        <Path Width="14" Height="14" Margin="0,0,4,4"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Cursor="SizeNWSE" Fill="#555555"
              Data="M 14,0 L 14,14 L 0,14 Z"
              PreviewMouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" />
        </Grid>
        </Viewbox>
    </Grid>
</Window>
