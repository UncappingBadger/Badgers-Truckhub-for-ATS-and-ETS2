<Window x:Class="TruckHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:TruckHub.Converters"
        xmlns:views="clr-namespace:TruckHub.Views"
        Title="TruckHub v1.1.1"
        Width="300" Height="330"
        MinWidth="260" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Hides via Visibility.Hidden (keeps layout space reserved) rather than Collapsed, so rows
             that toggle don't change the card's aspect ratio and make the Viewbox rescale everything -
             which reads as the whole window "resizing" even though the actual window bounds don't move. -->
        <conv:BoolToHiddenConverter x:Key="BoolToHidden" />
    </Window.Resources>

    <Grid>
        <!-- Viewbox scales the whole card (fonts, sign, everything) - and, while docked, the log
             drawer right alongside it - uniformly to fill however big/small the window is resized to,
             instead of just leaving blank space around it. The drawer lives inside this same Viewbox
             (see the 3-column Grid below: card / arrow tab / drawer) specifically so it inherits the
             card's own scaling while docked, rather than staying a fixed size independent of it -
             popping it out into LogWindow is what gives it its own independent size instead. -->
        <Viewbox Stretch="Uniform">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" x:Name="CardBorder" Background="#E6161616" CornerRadius="10"
                BorderBrush="#404040" BorderThickness="1" Width="400">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Same branding cluster as PalHub (app name / "By Badger" / version-or-build-tag)
                     for a consistent signature across the two apps. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="TRUCKHUB" Foreground="#888888" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="By Badger" Foreground="#FFC24C" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Text="v1.1.1" Foreground="#888888" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="⚙" Click="Settings_Click"
                        Width="20" Height="20" Padding="0" Margin="0,0,6,0" FontSize="11" Background="#2A2A2A"
                        Foreground="{Binding SettingsButtonColor}" BorderThickness="0"
                        ToolTip="{Binding SettingsButtonTooltip}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowUpdateIndicator}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FFC24C" ShadowDepth="0" BlurRadius="6" Opacity="0.6" />
                                        </Setter.Value>
                                    </Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="UpdateGlowStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                                  From="6" To="14" Duration="0:0:0.9"
                                                                  AutoReverse="True" RepeatBehavior="Forever" />
                                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                                  From="0.5" To="1" Duration="0:0:0.9"
                                                                  AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="UpdateGlowStoryboard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" Content="⛶" Click="Fullscreen_Click"
                        Width="20" Height="20" Padding="0" Margin="0,0,6,0" FontSize="11" Background="#2A2A2A"
                        Foreground="White" BorderThickness="0" ToolTip="Toggle fullscreen" />

                <Button Grid.Column="3" Content="✕" Click="Close_Click"
                        Width="20" Height="20" FontSize="10" Background="#2A2A2A"
                        Foreground="White" BorderThickness="0" />
            </Grid>

            <!-- Speed limit sign, centered alone, with turn signal arrows either side. The arrows
                 bind straight to the game's own current bulb state (BlinkerLeftOn/RightOn), which
                 already toggles at the real blink rate - hazards flash both together for free since
                 they drive the same two fields, no timer needed on our side. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10"
                        Visibility="{Binding SpeedSignVisibility}">

                <Viewbox Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Polygon Points="16,4 16,20 4,12" Fill="{Binding TurnSignalLeftColor}" />
                </Viewbox>

                <!-- Fixed-width slot so whichever sign renders (American rectangle, European
                     circle, or the placeholder) is centered within the same footprint - letting
                     each one size itself and re-center the row shifted everything sideways whenever
                     the sign type changed. -->
                <Grid Width="86">
                    <!-- US-style speed limit sign (ATS) -->
                    <Border Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="6"
                            Padding="4,6" HorizontalAlignment="Center"
                            Visibility="{Binding ShowAmericanSpeedSign, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SPEED" Foreground="Black" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="LIMIT" Foreground="Black" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,-2,0,2" />
                            <TextBlock Text="{Binding SpeedLimitValue}" Foreground="Black" FontWeight="Bold"
                                       FontSize="30" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- European round sign (ETS2): white disc, red ring, black number, no text -->
                    <Border Background="White" BorderBrush="#CC0000" BorderThickness="6" CornerRadius="32"
                            Width="65" Height="65" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEuropeanSpeedSign, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SpeedLimitValue}" Foreground="Black" FontWeight="Bold"
                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" CornerRadius="6"
                            Padding="4,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowSpeedPlaceholder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="--" Foreground="#666666" FontWeight="Bold" FontSize="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Viewbox Width="26" Height="26" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Polygon Points="8,4 8,20 20,12" Fill="{Binding TurnSignalRightColor}" />
                </Viewbox>
            </StackPanel>

            <!-- In-game clock, in its own row directly under the speed sign row so it lines up
                 underneath the sign itself rather than the turn-signal arrows either side of it.
                 Same panel background as the rest of the HUD (not a standalone black LCD box) so it
                 blends in - only the green monospace digits themselves signal "this is a clock", not
                 a boxed-off treatment that would make it stand out as its own separate widget. -->
            <Border Grid.Row="2" Background="#202020" CornerRadius="6"
                    Padding="8,4" Margin="0,0,0,10" HorizontalAlignment="Center" ToolTip="In-game time"
                    Visibility="{Binding GameClockVisibility}">
                <TextBlock Text="{Binding GameClockDisplay}" Foreground="#5FD85F" FontFamily="Consolas"
                           FontWeight="Bold" FontSize="20" />
            </Border>

            <!-- Lights status: informational, not fault-colored - dimmed grey when off, lit in each
                 light's real dashboard telltale color when on (blue for high beam is the near-
                 universal convention; green for sidelights/low beam, matching most real clusters;
                 amber for the beacon, matching its actual light color; parking brake reuses the same
                 neutral-white-when-engaged treatment as its old standalone box). Grouped with the
                 turn signals above since both are "lights", not vehicle-fault telemetry like the
                 warning cluster below. -->
            <Border Grid.Row="3" Background="#202020" CornerRadius="6" Margin="0,0,0,10" Padding="10,7"
                    Visibility="{Binding LightsStatusVisibility}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Parking brake: a status, not a fault - lit neutral white when engaged, dimmed
                         off. The emergency-brake-from-low-air warning stays a separate telltale in
                         the warning cluster below since that one IS a fault. -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Parking brake" Visibility="{Binding ParkingBrakeVisibility}">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding ParkingBrakeColor}" StrokeThickness="2" />
                            <TextBlock Text="P" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{Binding ParkingBrakeColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Retarder: circle + letter, same style as parking brake above, but the letter
                         itself swaps to the current level number while engaged (see HasRetarder /
                         RetarderDisplayText) since this one has levels, not just on/off. Only shown on
                         trucks that actually have a retarder fitted. Grouped with parking brake and
                         engine brake below - all three are the same braking system, just different
                         use cases. -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Retarder"
                             Visibility="{Binding HasRetarder, Converter={StaticResource BoolToVis}}">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding RetarderColor}" StrokeThickness="2" />
                            <TextBlock Text="{Binding RetarderDisplayText}" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding RetarderColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Engine brake: same circle + letter style, plain on/off. Letter is sim-dependent -
                         "J" (Jake brake) in ATS, "E" (engine brake) in ETS2 - see JakeBrakeLetter. -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Engine brake">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding JakeBrakeColor}" StrokeThickness="2" />
                            <TextBlock Text="{Binding JakeBrakeLetter}" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding JakeBrakeColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Sidelights: lamp only, no beam -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Sidelights">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="6"
                                     Stroke="{Binding SidelightsColor}" StrokeThickness="1.6" />
                            <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10"
                                     Fill="{Binding SidelightsColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low beam: lamp + downward-angled beams -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low beam">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="7" Canvas.Left="2" Canvas.Top="8"
                                     Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="9" X2="20" Y2="6" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="11.5" X2="21" Y2="11.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="14" X2="20" Y2="17" StrokeStartLineCap="Round"
                                  Stroke="{Binding LowBeamColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- High beam: same lamp, straight/parallel beams instead of angled -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="High beam">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="7" Canvas.Left="2" Canvas.Top="8"
                                     Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="7" X2="21" Y2="7" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="11.5" X2="21" Y2="11.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                            <Line X1="13" Y1="16" X2="21" Y2="16" StrokeStartLineCap="Round"
                                  Stroke="{Binding HighBeamColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Beacon: dome + radiating rays -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Beacon">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,16 A4,4 0 0 1 16,16 Z" Fill="{Binding BeaconColor}" />
                            <Line X1="12" Y1="16" X2="12" Y2="19" Stroke="{Binding BeaconColor}" StrokeThickness="1.6" />
                            <Line X1="4" Y1="10" X2="6.5" Y2="12.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                            <Line X1="20" Y1="10" X2="17.5" Y2="12.5" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                            <Line X1="12" Y1="5" X2="12" Y2="8" StrokeStartLineCap="Round"
                                  Stroke="{Binding BeaconColor}" StrokeThickness="1.4" />
                        </Canvas>
                    </Viewbox>

                    <!-- Differential lock: padlock -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Differential lock">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,11 L8,8 A4,4 0 0 1 16,8 L16,11" Fill="Transparent"
                                  Stroke="{Binding DiffLockColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="6" Canvas.Top="11" Width="12" Height="9" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{Binding DiffLockColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Lift/tag axle: wheel + up-arrow. Only shown if this truck actually has one
                         (see HasLiftAxle). Dimmed = down (normal, full axle load); lit = up (lifted). -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Lift/tag axle"
                             Visibility="{Binding HasLiftAxle, Converter={StaticResource BoolToVis}}">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="11"
                                     Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="12" Y1="3" X2="12" Y2="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="9" Y1="6" X2="12" Y2="3" StrokeStartLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                            <Line X1="15" Y1="6" X2="12" Y2="3" StrokeStartLineCap="Round"
                                  Stroke="{Binding LiftAxleColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- Warnings: individual telltales like a real instrument cluster - each mirrors the SDK's
                 own dashboard warning-light booleans (no thresholds of our own), dimmed grey until its
                 condition trips, then lights up in real dashboard colors (red = safety-critical,
                 amber = needs attention soon). Grouped with the Lights row above (both "cluster"
                 style icon strips), ahead of the trip-computer info below, since warnings are the
                 most urgent thing to see. -->
            <Border Grid.Row="4" Background="#202020" CornerRadius="6" Margin="0,0,0,10" Padding="10,7"
                    Visibility="{Binding WarningsVisibility}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Low air pressure: circle + "!" (SAE/ISO air-brake warning symbol) -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low air pressure">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                     Stroke="{Binding AirPressureWarnColor}" StrokeThickness="2" />
                            <Line X1="12" Y1="6" X2="12" Y2="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding AirPressureWarnColor}" StrokeThickness="2" />
                            <Ellipse Width="2" Height="2" Canvas.Left="11" Canvas.Top="16"
                                     Fill="{Binding AirPressureWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Parking brake (auto-applied on critically low air): circle + "P" -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Emergency / parking brake">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="20" Height="20" Stroke="{Binding ParkingBrakeWarnColor}" StrokeThickness="2" />
                            <TextBlock Text="P" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{Binding ParkingBrakeWarnColor}" />
                        </Grid>
                    </Viewbox>

                    <!-- Oil pressure: oil can + drip -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Oil pressure">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="11" Height="8" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding OilPressureWarnColor}" StrokeThickness="1.6" />
                            <Line X1="15" Y1="11" X2="19" Y2="7" StrokeStartLineCap="Round"
                                  Stroke="{Binding OilPressureWarnColor}" StrokeThickness="1.6" />
                            <Ellipse Width="3" Height="3" Canvas.Left="18.5" Canvas.Top="3.5"
                                     Fill="{Binding OilPressureWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Water temperature: thermometer -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Engine temperature">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="4" Height="13" RadiusX="2" RadiusY="2"
                                       Stroke="{Binding WaterTempWarnColor}" StrokeThickness="1.6" />
                            <Ellipse Width="8" Height="8" Canvas.Left="8" Canvas.Top="14"
                                     Stroke="{Binding WaterTempWarnColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low fuel: pump body + hose/nozzle -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low fuel">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="7" Width="9" Height="13" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="5" Height="3"
                                       Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                            <Path Data="M13,10 L18,10 L18,16 A2,2 0 0 1 16,18" Fill="Transparent"
                                  Stroke="{Binding FuelWarnColor}" StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>

                    <!-- Low AdBlue: droplet -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Low AdBlue">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 C12,3 6,11 6,15 A6,6 0 1 0 18,15 C18,11 12,3 12,3 Z"
                                  Fill="{Binding AdBlueWarnColor}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Battery / charging system -->
                    <Viewbox Width="22" Height="22" Margin="4,0" ToolTip="Battery / charging system">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="8" Width="16" Height="10" RadiusX="1" RadiusY="1"
                                       Stroke="{Binding BatteryWarnColor}" StrokeThickness="1.6" />
                            <Rectangle Canvas.Left="8" Canvas.Top="5" Width="3" Height="3" Fill="{Binding BatteryWarnColor}" />
                            <Rectangle Canvas.Left="13" Canvas.Top="5" Width="3" Height="3" Fill="{Binding BatteryWarnColor}" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- Speed + RPM side by side, each with Fuel/Cruise+Gear stacked underneath - two columns
                 instead of four stacked full-width rows, now that the card itself is wide enough for
                 two dials across. Speed/RPM keep the same ~200° dial treatment as before (tick marks,
                 sweeping needle, small digital readout). No fixed colour zone on Speed's dial, unlike
                 RPM's redline - "good speed" depends on the current speed limit, which changes
                 throughout a drive, so the needle (and the digital number) carry the colour instead.
                 RPM's redline genuinely is a fixed position on its own dial face, because the dial's
                 scale always stretches to match whatever this truck's actual redline (EngineRpmMax) is
                 - "the last 15% of the dial" is always the right spot regardless of the underlying RPM
                 number, so unlike the needle angle it doesn't need to be computed dynamically. -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

                <!-- Left column: Speed, then Fuel underneath. -->
                <StackPanel Width="185">
                    <Border Background="#202020" CornerRadius="6" Padding="10,7"
                            Visibility="{Binding SpeedSectionVisibility}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SPEED" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Canvas Width="140" Height="84" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Path Data="M 24.70,71.99 A 46,46 0 1 1 115.30,71.99" Stroke="#3A3A3A" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="24.70" Y1="71.99" X2="32.58" Y2="70.60" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="30.16" Y1="41.00" X2="37.09" Y2="45.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="54.27" Y1="20.77" X2="57.00" Y2="28.29" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="70" Y1="18.00" X2="70" Y2="26.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="85.73" Y1="20.77" X2="83.00" Y2="28.29" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="109.84" Y1="41.00" X2="102.91" Y2="45.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="115.30" Y1="71.99" X2="107.42" Y2="70.60" Stroke="#3A3A3A" StrokeThickness="3" />
                                <TextBlock Text="0" Canvas.Left="12" Canvas.Top="68" Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding SpeedGaugeMidLabel}" Canvas.Top="2" Width="140" TextAlignment="Center"
                                           Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding SpeedGaugeMaxLabel}" Canvas.Left="105" Canvas.Top="68"
                                           Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <Line X1="70" Y1="64" X2="70" Y2="24" Stroke="{Binding SpeedColor}" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform Angle="{Binding SpeedNeedleAngle}" CenterX="70" CenterY="64" />
                                    </Line.RenderTransform>
                                </Line>
                                <Ellipse Canvas.Left="64" Canvas.Top="58" Width="12" Height="12" Fill="#888888" />
                            </Canvas>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SpeedValue}" Foreground="{Binding SpeedColor}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding UnitLabel}" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Bottom" Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fuel + AdBlue gauge: grouped with the other truck instrumentation rather than
                         down with job info, since neither is job-specific. -->
                    <Border Background="#202020" CornerRadius="6" Margin="0,10,0,0" Padding="10,7"
                            Visibility="{Binding FuelSectionVisibility}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FUEL" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Canvas Width="120" Height="70" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Path Data="M 27.10,27 A 38,38 0 0 1 92.90,27" Stroke="#3A3A3A" StrokeThickness="4"
                              StrokeStartLineCap="Flat" StrokeEndLineCap="Round" />
                        <!-- Reserve zone: real fuel gauges mark roughly the last 1/8 (12.5%) of the
                             dial in red - a fixed mark on the dial face, not tied to the live warning
                             flag (that has its own telltale near "E"). -->
                        <Path Data="M 27.10,27 A 38,38 0 0 1 33.13,19.13" Stroke="#FF4C4C" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Flat" />
                        <Line X1="27.10" Y1="27" X2="33.15" Y2="30.5" Stroke="#3A3A3A" StrokeThickness="3" />
                        <Line X1="60" Y1="8" X2="60" Y2="15" Stroke="#3A3A3A" StrokeThickness="3" />
                        <Line X1="92.90" Y1="27" X2="86.85" Y2="30.5" Stroke="#3A3A3A" StrokeThickness="3" />
                        <TextBlock Text="E" Canvas.Left="14" Canvas.Top="26" Foreground="#666666" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="F" Canvas.Left="97" Canvas.Top="26" Foreground="#666666" FontSize="9" FontWeight="Bold" />
                        <Line X1="60" Y1="46" X2="60" Y2="13" Stroke="#E8E8E8" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform>
                                <RotateTransform Angle="{Binding FuelNeedleAngle}" CenterX="60" CenterY="46" />
                            </Line.RenderTransform>
                        </Line>
                        <Ellipse Canvas.Left="55" Canvas.Top="41" Width="10" Height="10" Fill="#888888" />

                        <!-- Low-fuel telltale: a plain warning light near "E", same as a real gauge -
                             tucked just below-left of the dial's own "E", clear of the arc/tick/needle. -->
                        <Ellipse Canvas.Left="16" Canvas.Top="42" Width="8" Height="8" Fill="{Binding FuelWarnColor}"
                                 ToolTip="Low fuel" />

                        <!-- AdBlue: 4 discrete quarter-segments built into the same gauge face below
                             the needle pivot, with its own "E"/"F" marks and low-level telltale. -->
                        <Ellipse Canvas.Left="2" Canvas.Top="57" Width="8" Height="8" Fill="{Binding AdBlueWarnColor}"
                                 ToolTip="Low AdBlue" Visibility="{Binding AdBlueVisibility}" />
                        <TextBlock Text="E" Canvas.Left="12" Canvas.Top="56" Foreground="#666666" FontSize="9"
                                   FontWeight="Bold" Visibility="{Binding AdBlueVisibility}" />
                        <UniformGrid Canvas.Left="22" Canvas.Top="57" Width="82" Height="10" Columns="4"
                                     Visibility="{Binding AdBlueVisibility}">
                            <Border Margin="0,0,2,0" Background="#3A3A3A" CornerRadius="2">
                                <Border Background="#3ECF6B" CornerRadius="2"
                                        Visibility="{Binding AdBlueSegment1Lit, Converter={StaticResource BoolToVis}}" />
                            </Border>
                            <Border Margin="0,0,2,0" Background="#3A3A3A" CornerRadius="2">
                                <Border Background="#3ECF6B" CornerRadius="2"
                                        Visibility="{Binding AdBlueSegment2Lit, Converter={StaticResource BoolToVis}}" />
                            </Border>
                            <Border Margin="0,0,2,0" Background="#3A3A3A" CornerRadius="2">
                                <Border Background="#3ECF6B" CornerRadius="2"
                                        Visibility="{Binding AdBlueSegment3Lit, Converter={StaticResource BoolToVis}}" />
                            </Border>
                            <Border Background="#3A3A3A" CornerRadius="2">
                                <Border Background="#3ECF6B" CornerRadius="2"
                                        Visibility="{Binding AdBlueSegment4Lit, Converter={StaticResource BoolToVis}}" />
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="F" Canvas.Left="106" Canvas.Top="56" Foreground="#666666" FontSize="9"
                                   FontWeight="Bold" Visibility="{Binding AdBlueVisibility}" />
                    </Canvas>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column: RPM, then Cruise + Gear underneath. Each keeps its own original
                     Visibility (previously Cruise was accidentally also hidden whenever the Speed
                     section was off, since they shared one row/Visibility - decoupled now that
                     they're not sharing a row with Speed anymore). -->
                <StackPanel Width="185" Margin="10,0,0,0">
                    <Border Background="#202020" CornerRadius="6" Padding="10,7"
                            Visibility="{Binding GearRpmSectionVisibility}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="RPM" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Canvas Width="140" Height="84" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Path Data="M 24.70,71.99 A 46,46 0 1 1 115.30,71.99" Stroke="#3A3A3A" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M 113.20,48.30 A 46,46 0 0 1 115.30,71.99" Stroke="#FF4C4C" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="24.70" Y1="71.99" X2="32.58" Y2="70.60" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="30.16" Y1="41.00" X2="37.09" Y2="45.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="54.27" Y1="20.77" X2="57.00" Y2="28.29" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="70" Y1="18.00" X2="70" Y2="26.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="85.73" Y1="20.77" X2="83.00" Y2="28.29" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="109.84" Y1="41.00" X2="102.91" Y2="45.00" Stroke="#3A3A3A" StrokeThickness="3" />
                                <Line X1="115.30" Y1="71.99" X2="107.42" Y2="70.60" Stroke="#3A3A3A" StrokeThickness="3" />
                                <TextBlock Text="0" Canvas.Left="12" Canvas.Top="68" Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding RpmGaugeMidLabel}" Canvas.Top="2" Width="140" TextAlignment="Center"
                                           Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding RpmGaugeMaxLabel}" Canvas.Left="105" Canvas.Top="68"
                                           Foreground="#666666" FontSize="9" FontWeight="Bold" />
                                <Line X1="70" Y1="64" X2="70" Y2="24" Stroke="{Binding RpmColor}" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform Angle="{Binding RpmNeedleAngle}" CenterX="70" CenterY="64" />
                                    </Line.RenderTransform>
                                </Line>
                                <Ellipse Canvas.Left="64" Canvas.Top="58" Width="12" Height="12" Fill="#888888" />
                            </Canvas>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding RpmDisplay}" Foreground="{Binding RpmColor}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="RPM" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Bottom" Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Height bumped to roughly match the Fuel gauge box on the left, so both
                         columns' bottom edges line up instead of Fuel visibly running taller. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Background="#202020" CornerRadius="6" Width="87" Height="102"
                                Visibility="{Binding CruiseControlVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="27" Height="27" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                                 Stroke="{Binding CruiseControlColor}" StrokeThickness="2" />
                                        <Line X1="12" Y1="12" X2="17" Y2="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding CruiseControlColor}" StrokeThickness="2" />
                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10"
                                                 Fill="{Binding CruiseControlColor}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding CruiseControlDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="{Binding CruiseControlColor}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#202020" CornerRadius="6" Width="87" Height="102" Margin="11,0,0,0"
                                Visibility="{Binding GearRpmSectionVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="GEAR" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding GearDisplay}" Foreground="White" FontSize="32"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Status / Job panel -->
            <Grid Grid.Row="6">

                <TextBlock Text="{Binding StatusMessage}" Foreground="#999999" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToHidden}}" />

                <StackPanel Visibility="{Binding ShowJobPanel, Converter={StaticResource BoolToHidden}}">
                    <TextBlock Text="{Binding RouteDisplay}" Foreground="White" FontSize="17"
                               FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Stretch" Visibility="{Binding RouteVisibility}" />

                    <TextBlock Text="{Binding CargoDisplay}" Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,3,0,0"
                               Visibility="{Binding CargoVisibility}" />

                    <!-- Horizontal StackPanel (not a Grid) so that if any of these three are
                         disabled, the row re-centers around whatever's left instead of leaving a
                         blank gap. Each box shares the same fixed height so the row lines up evenly
                         regardless of how many lines its own content needs. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Background="#202020" CornerRadius="6" Height="96" Padding="11,11" Margin="0,0,10,0"
                                Visibility="{Binding PayoutVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PAYOUT" Foreground="#888888" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding IncomeDisplay}" Foreground="#5FD85F" FontSize="22"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PricePerDistanceDisplay}" Foreground="#AAAAAA" FontSize="14"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#202020" CornerRadius="6" Height="96" Padding="11,11" Margin="0,0,10,0"
                                Visibility="{Binding DistanceVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="DISTANCE" Foreground="#888888" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DistanceTraveledDisplay}" Foreground="White" FontSize="22"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="14">
                                    <Run Text="of " /><Run Text="{Binding DistanceTotalDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#202020" CornerRadius="6" Height="96" Padding="11,11"
                                Visibility="{Binding TimeLeftVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TIME LEFT" Foreground="#888888" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingTimeDisplay}" Foreground="White" FontSize="22"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Trip fuel needs / economy: job-relative stats, kept separate from the always-on
                 fuel/AdBlue gauge above. -->
            <Border Grid.Row="7" Background="#202020" CornerRadius="6" Margin="0,10,0,0" Padding="12,10"
                    Visibility="{Binding FuelSectionVisibility}">
                <StackPanel>
                    <Grid Visibility="{Binding TripFuelForecastVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TRIP NEEDS" Foreground="#888888" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FuelForecastDisplay}" Foreground="{Binding TripFuelColor}"
                                   FontSize="19" FontWeight="Bold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,8,0,0" Visibility="{Binding FuelEconomyVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ECONOMY" Foreground="#888888" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FuelEconomyDisplay}" Foreground="White" FontSize="19"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Rest timer: its own box, same treatment as the Fuel card, since fatigue accrues
                 whether or not a job is active. -->
            <Border Grid.Row="8" Background="#202020" CornerRadius="6" Margin="0,10,0,0" Padding="12,10"
                    Visibility="{Binding RestTimeVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="REST" Foreground="#888888" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding RestTimeDisplay}" Foreground="{Binding RestTimeColor}"
                               FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        </Border>

        <!-- Manual resize grip: WindowStyle=None + AllowsTransparency windows get no OS resize border,
             so dragging this triggers the standard native resize loop via WM_SYSCOMMAND/SC_SIZE.
             Grid.Column="0" pins it to the card's own column specifically (not the drawer's, now that
             there's a column further right) so it tracks the card's actual corner regardless of
             whether the drawer is open. -->
        <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,4,4"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Cursor="SizeNWSE" Fill="#555555"
              Data="M 14,0 L 14,14 L 0,14 Z"
              PreviewMouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" />

        <!-- Job log toggle tab, in its own column immediately right of the card. -->
        <Button Grid.Column="1" x:Name="LogToggleButton" Content="›" Click="ToggleLog_Click"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Width="18" Height="40" FontSize="13" FontWeight="Bold"
                Background="#E6161616" Foreground="#AAAAAA" BorderBrush="#404040" BorderThickness="0,1,1,1"
                Padding="0" Cursor="Hand" ToolTip="Job log" />

        <!-- Docked log drawer, in its own column right of the arrow tab - inside the same Viewbox as
             the card (see the comment up top) so it scales together with it while docked.
             JobLogView has no explicit Width of its own - it stretches to fill whatever
             LogDrawerBorder's animated Width currently is, minus its own Margin, so there's no
             separate number to keep in sync by hand (a previous version tried that and got the two
             numbers out of sync, clipping the pop-out button off the edge).
             Height IS fixed, though - without it, the Border's natural height grows with the job list
             (JobLogView's internal ScrollViewer can't enforce a scroll limit without something bounding
             its available height first), and since this shares an Auto-height row with Speed/RPM/Fuel/
             Cruise/Gear, that growth was inflating the whole row - and so the whole window - taller
             every time a job got logged, even while docked-closed at Width="0". Originally matched
             the ~250px height of the Speed+Fuel / RPM+Cruise+Gear columns it sits alongside; bumped
             50% taller (and LogDrawerWidth 50% wider) per explicit request for a roomier docked view -
             it now overhangs those columns rather than lining up with them, which is fine. -->
        <Border Grid.Column="2" x:Name="LogDrawerBorder" Width="0" Height="375" ClipToBounds="True" Margin="3,0,0,0"
                Background="#E6161616" BorderBrush="#404040" BorderThickness="0,1,1,1">
            <views:JobLogView x:Name="LogView" Margin="10" PopOutRequested="LogView_PopOutRequested" />
        </Border>
        </Grid>
        </Viewbox>
    </Grid>
</Window>
