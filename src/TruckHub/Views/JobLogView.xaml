<UserControl x:Class="TruckHub.Views.JobLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">

    <UserControl.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="JOB LOG" Foreground="White" FontSize="13" FontWeight="Bold"
                       VerticalAlignment="Center" />

            <!-- Pops the whole log out into its own independent, resizable window - hidden when
                 already popped out (SetPopOutButtonVisible(false)), since there's nothing further to
                 pop out to at that point. -->
            <Button x:Name="PopOutButton" Grid.Column="1" Content="⤢" Click="PopOut_Click"
                    Width="20" Height="20" Padding="0" FontSize="11" Background="#2A2A2A"
                    Foreground="White" BorderThickness="0" ToolTip="Pop out into its own window" />
        </Grid>

        <Border Grid.Row="1" Background="#202020" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="TOTAL PAYOUT" Foreground="#888888" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalPayoutDisplay}" Foreground="#5FD85F" FontSize="13"
                               FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="TOTAL MILES" Foreground="#888888" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalMileageDisplay}" Foreground="White" FontSize="13"
                               FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="No jobs logged yet" Foreground="#666666" FontSize="11"
                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"
                   Visibility="{Binding HasNoLogEntries, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding JobLog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202020" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Pickup}" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DropOff}" Foreground="#AAAAAA" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,1,0,0" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PayoutDisplay}" Foreground="#5FD85F"
                                               FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding MileageDisplay}" Foreground="#888888"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Right"
                                               HorizontalAlignment="Right" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
