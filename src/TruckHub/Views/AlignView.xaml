<UserControl x:Class="TruckHub.Views.AlignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:TruckHub.Controls">

    <!-- The ALIGN panel's content, shared between the drawer docked above the main window and the standalone
         AlignWindow it can pop out into - both embed this and set DataContext to the same AlignViewModel (the same
         arrangement as JobLogView). Rows: header / rear-camera picture with the status as its caption / readouts. -->

    <UserControl.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="ALIGN" Foreground="White" FontSize="13" FontWeight="Bold"
                       VerticalAlignment="Center" />

            <!-- Pops the panel out into its own independent, resizable window - hidden when already popped out
                 (SetPopOutButtonVisible(false)), exactly like the job log's. -->
            <Button x:Name="PopOutButton" Grid.Column="1" Content="&#x2922;" Click="PopOut_Click"
                    Width="20" Height="20" Padding="0" FontSize="11" Background="#2A2A2A"
                    Foreground="White" BorderThickness="0" ToolTip="Pop out into its own window" />
        </Grid>

        <!-- Same "no info until a game's actually detected" behaviour as the main window and EXT: until the sim is connected
             this line is all there is; the picture and the readouts below only appear once it is. -->
        <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="{Binding WaitingMessage}" Foreground="#999999" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}" />

        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="#101216" MinHeight="90"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Grid>
                <controls:AlignCameraView Frame="{Binding Frame}" />

                <!-- Centred message when there is nothing to draw (no game / no trailer / old plugin). -->
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="14"
                           FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"
                           Visibility="{Binding ShowOverlayMessage, Converter={StaticResource BoolToVis}}" />

                <!-- The status as a caption, like the banner on a pickup's reversing camera - but along the TOP, over the empty
                     sky, because the bottom is where the kingpin target ends up when you are close, which is when you need it. -->
                <Border VerticalAlignment="Top" Padding="8,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B0000000" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowOverlayMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- Backing in over the baseline speed: the banner goes red (its text is white). -->
                                <DataTrigger Binding="{Binding SlowDown}" Value="True">
                                    <Setter Property="Background" Value="#E0C01818" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12"
                               FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#202020" CornerRadius="6" Padding="4,5" Margin="0,0,3,0">
                <StackPanel>
                    <TextBlock Text="SIDE" Style="{StaticResource TileLabel}" ToolTip="How far the kingpin is to the left or right of your fifth wheel's line" />
                    <TextBlock Text="{Binding SideText}" Foreground="{Binding SideColor}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#202020" CornerRadius="6" Padding="4,5" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="GAP" Style="{StaticResource TileLabel}" ToolTip="How much further back the kingpin is from your fifth wheel" />
                    <TextBlock Text="{Binding GapText}" Foreground="{Binding GapColor}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#202020" CornerRadius="6" Padding="4,5" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="HEIGHT" Style="{StaticResource TileLabel}" ToolTip="The kingpin's height against your fifth wheel (up arrow = trailer higher)" />
                    <TextBlock Text="{Binding HeightText}" Foreground="{Binding HeightColor}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#202020" CornerRadius="6" Padding="4,5" Margin="3,0,0,0">
                <StackPanel>
                    <TextBlock Text="ANGLE" Style="{StaticResource TileLabel}" ToolTip="How far the trailer is turned from your truck" />
                    <TextBlock Text="{Binding AngleText}" Foreground="{Binding AngleColor}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
