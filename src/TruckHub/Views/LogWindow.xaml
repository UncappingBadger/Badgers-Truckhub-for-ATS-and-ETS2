<Window x:Class="TruckHub.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TruckHub.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TruckHub - Job Log"
        Width="304" Height="491"
        MinWidth="220" MinHeight="220"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#161616"
        Topmost="True">

    <!-- WindowChrome instead of a fully custom (WindowStyle=None + AllowsTransparency) window like
         MainWindow: CaptionHeight=0 hides the native title bar/buttons so we can draw our own to match
         the app's dark look, but ResizeMode=CanResize + WindowChrome still gives real native resize
         from any edge (with the normal resize cursors, and Aero Snap) for free - reimplementing that
         by hand the way MainWindow's single-corner grip does would be a lot more work for a window
         that's meant to be freely resizable, not just from one corner. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#202020" Height="28" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="TRUCKHUB · JOB LOG" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

            <!-- Only clickable control in the custom title bar, so it needs WindowChrome's hit-test
                 exemption or the drag-move handler above would swallow the click as a window drag. -->
            <Button Grid.Column="1" Content="✕" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Width="28" Height="28" FontSize="10" Background="Transparent"
                    Foreground="White" BorderThickness="0" />
        </Grid>

        <views:JobLogView Grid.Row="1" x:Name="LogView" Margin="12" />
    </Grid>
</Window>
