<Window x:Class="TruckHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TruckHub Settings"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#161616">

    <!-- Same treatment as LogWindow: WindowChrome with CaptionHeight=0 strips the native title bar
         so we can draw our own to match the app's dark look, no native resize needed here since this
         window is fixed-width/content-height. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Width" Value="50" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Slider in the app's dark look: thin grey track, green fill up to the thumb (same green
             as the HUD's "good" colour), small light thumb. Horizontal only - the one slider here is
             the over-limit beep volume. -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#5FD85F" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="4" CornerRadius="2" Background="#404040" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="12" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#DDDDDD" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row per speed-alert sound: "Volume [slider] 50% [Test]". Dimmed while its sound is off. -->
        <Style x:Key="VolumeRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="20,2,0,14" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Flat template: the stock Button template paints a bright white box when disabled, which
             looks wrong on this dark window. -->
        <Style x:Key="FlatTestButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4A4A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Browser-style tab: flat top corners only, no chrome of its own - the active tab shares
             the content panel's exact background colour (#1E1E1E) so it visually "merges" straight
             into the panel below, while inactive tabs sit dimmer against the title bar's darker
             background behind them, same illusion a browser's own tab strip uses. -->
        <Style x:Key="BrowserTabBase" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#161616" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <!-- Two tabs, filling the full width - only the outer corner of each rounds (top-left for
             the left tab, top-right for the right one), so they meet in a flat seam in the middle
             instead of a rounded notch where two curves would otherwise face each other. -->
        <Style x:Key="BrowserTabLeft" TargetType="Button" BasedOn="{StaticResource BrowserTabBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8,0,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowserTabRight" TargetType="Button" BasedOn="{StaticResource BrowserTabBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar, replacing the native one entirely. -->
        <Grid Grid.Row="0" Background="#202020" Height="28" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="TRUCKHUB · SETTINGS" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

            <Button Grid.Column="1" Content="✕" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Width="28" Height="28" FontSize="10" Background="Transparent"
                    Foreground="White" BorderThickness="0" Margin="0" />
        </Grid>

        <!-- Browser-style tab strip - only 2 tabs exist and neither more are planned, so each one
             stretches to fill half the width rather than sizing to its own text, matching the
             content panel's full width below instead of leaving dead space to the right. -->
        <Grid Grid.Row="1" Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="App Configure" Command="{Binding SelectAppConfigureTabCommand}"
                    HorizontalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BrowserTabLeft}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAppConfigureTab}" Value="True">
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1" Content="UI Setup" Command="{Binding SelectUiSetupTabCommand}"
                    HorizontalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BrowserTabRight}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUiSetupTab}" Value="True">
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Content panel: same background as the active tab above it (#1E1E1E), square top-left
             corner where it meets the tab strip, rounded everywhere else. Capped height + scrollbar
             so a tall tab's content can never push the (fixed-size, no native resize) window taller
             than the screen with no way to reach what's below. -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="0,8,8,8" Margin="16,0,16,0">
            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                    <!-- App Configure: update check, game install locations, gearbox calibration -
                         the things about the app/game setup rather than how the HUD itself looks. -->
                    <StackPanel Visibility="{Binding IsAppConfigureTab, Converter={StaticResource BoolToVis}}">
                        <!-- Update check -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="#AAAAAA" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button Content="Download update" Command="{Binding OpenUpdateLinkCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,8"
                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}" />

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <TextBlock Text="Game install locations" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                            TruckHub auto-detects Steam installs. If a game isn't found - a non-Steam copy, or a
                            library drive Steam can't see right now - point it at the install folder manually.
                        </TextBlock>

                        <!-- ETS2 -->
                        <TextBlock Text="Euro Truck Simulator 2" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Ets2StatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Browse..." Command="{Binding BrowseEts2Command}" />
                            <Button Content="Clear override" Command="{Binding ClearEts2Command}"
                                    Visibility="{Binding HasManualEts2Path, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- ATS -->
                        <TextBlock Text="American Truck Simulator" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AtsStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Browse..." Command="{Binding BrowseAtsCommand}" />
                            <Button Content="Clear override" Command="{Binding ClearAtsCommand}"
                                    Visibility="{Binding HasManualAtsPath, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <!-- Mod folder locations -->
                        <TextBlock Text="Mod folder locations" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                            Used by the mod load-order suggestion (the ☰ button on the main window). Auto-detects
                            the standard Documents mod folder - only set this if yours is somewhere nonstandard.
                        </TextBlock>

                        <!-- ETS2 -->
                        <TextBlock Text="Euro Truck Simulator 2" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Ets2ModFolderStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Browse..." Command="{Binding BrowseEts2ModFolderCommand}" />
                            <Button Content="Clear override" Command="{Binding ClearEts2ModFolderCommand}"
                                    Visibility="{Binding HasManualEts2ModFolder, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- ATS -->
                        <TextBlock Text="American Truck Simulator" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AtsModFolderStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Browse..." Command="{Binding BrowseAtsModFolderCommand}" />
                            <Button Content="Clear override" Command="{Binding ClearAtsModFolderCommand}"
                                    Visibility="{Binding HasManualAtsModFolder, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <!-- Gearbox calibration -->
                        <TextBlock Text="Gearbox calibration" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                            ATS resets your H-shifter to neutral the moment the game window loses focus, so tabbing
                            in here to read the live gear doesn't work. Instead: while driving, with ATS still
                            focused, shift into the gear you want and press <Run FontWeight="Bold" Foreground="White">Ctrl+Alt+G</Run>
                            to capture it. Then come label it here whenever's convenient - Low/High range is
                            automatic (just adds the L/H suffix); a splitter that remaps the same stick slots to
                            different gears needs its own capture and Set below.
                        </TextBlock>
                        <TextBlock Text="{Binding GearboxStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PendingCaptureDisplay}" Foreground="#7FB0FF" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <!-- These two rows only appear once a live H-shifter gearbox is actually detected
                             (IsGearboxConnected/HasSplitter) - an automatic/sequential truck, or no game
                             running at all, has nothing to calibrate, which GearboxStatusDisplay above
                             already explains in plain text rather than showing empty/disabled boxes. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsGearboxConnected, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding NormalGearNumberInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Set gear" Command="{Binding SetNormalGearCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding HasSplitter, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding SplitterGearNumberInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Set gear (splitter engaged)" Command="{Binding SetSplitterGearCommand}" />
                        </StackPanel>

                        <Button Content="Clear calibration" Command="{Binding ClearCalibrationCommand}"
                                HorizontalAlignment="Left" />

                        <Rectangle Height="1" Fill="#333333" Margin="0,16,0,16" />

                        <!-- GPS route: manual reroute (default) or automatic. Logic lives in Services\OffRouteMonitor.cs. -->
                        <TextBlock Text="GPS route" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            By default TruckHub leaves your route alone when you pull off it - stopping for fuel, a
                            rest area or a service station does not rebuild it. If you end up a mile or more from the
                            route (a mile of actual driving), a red OFF ROUTE warning and a Reroute button appear on the GPS map (the hotkey
                            Ctrl+Alt+F8 does the same from inside the game), and you choose when to recompute.
                        </TextBlock>
                        <CheckBox IsChecked="{Binding AutoRerouteEnabled}">
                            <TextBlock TextWrapping="Wrap" Text="Recompute the route automatically when I leave it" />
                        </CheckBox>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12">
                            Turn this on for the earlier behaviour: as soon as you are more than 200 m (about
                            650 ft) off the route, TruckHub recalculates it for you. Handy if you'd rather never touch a
                            button, but every fuel stop or rest area off the highway will trigger a recalculation.
                        </TextBlock>
                        <Rectangle Height="1" Fill="#333333" Margin="0,16,0,16" />

                        <!-- Rendering: CPU vs GPU drawing. Two independent switches (HUD windows / GPS map), each
                             applied at startup only - see Services\RenderSettings.cs for why. The full explanation
                             lives in the manual; this is the short version a user needs to decide. -->
                        <TextBlock Text="Rendering" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            TruckHub normally draws everything on your graphics card (GPU). If your game is already
                            pushing the GPU hard, you can move TruckHub's drawing onto your processor (CPU) instead.
                            The two switches are independent and each takes effect the next time TruckHub starts.
                            Leave both off unless you're having problems.
                        </TextBlock>

                        <CheckBox IsChecked="{Binding HudSoftwareRendering}">
                            <TextBlock TextWrapping="Wrap" Text="Draw the HUD windows on the CPU" />
                        </CheckBox>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12">
                            Covers the main dash, the EXT gauges and TruckHub's other windows. Try it if the HUD
                            stutters, freezes for a few seconds, or shows black or see-through boxes while your game
                            is maxing out the GPU. It frees TruckHub's share of GPU time and memory in exchange for a
                            small amount of CPU.
                        </TextBlock>

                        <CheckBox IsChecked="{Binding MapSoftwareRendering}">
                            <TextBlock TextWrapping="Wrap" Text="Draw the GPS map on the CPU" />
                        </CheckBox>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12">
                            The map runs in a built-in browser; this turns the browser's graphics acceleration off so
                            your CPU draws the map instead. Try it if the map competes with your game for the GPU.
                            In testing it held the same 30 frames per second using about 13% of one CPU core while
                            following a truck, on a fast desktop processor - on a slower CPU, or a game that is
                            already CPU-bound, leave it off.
                        </TextBlock>

                        <TextBlock Foreground="#FFC24C" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="TRUCKHUB_RENDER is set on this PC and is overriding both switches."
                                   Visibility="{Binding RenderOverrideActive, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                    Visibility="{Binding RenderRestartNeeded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Restart TruckHub to apply your change." Foreground="#FFC24C" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="Restart now" Command="{Binding RestartCommand}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,16,0,16" />

                        <!-- ALIGN: the hitch alignment window. Its tab on the main window always works; this only governs the
                             global hotkey. Logic lives in MainWindow (ApplyAlignHotkeySetting). -->
                        <TextBlock Text="ALIGN (hitch alignment)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            The ALIGN tab opens a reversing-camera-style view that helps you back your truck onto a trailer: it
                            shows how far the trailer's kingpin is from your fifth wheel - sideways, back and in height - and turns
                            green when you are lined up. It works for a trailer you have dropped and for a job's trailer waiting
                            in the yard, in either coupling mode.
                        </TextBlock>
                        <CheckBox IsChecked="{Binding AlignHotkeyEnabled}">
                            <TextBlock TextWrapping="Wrap" Text="Open and close ALIGN with the hotkey Ctrl+Alt+. (period)" />
                        </CheckBox>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12">
                            Works from inside the game. Neither game uses that key combination. Turn this off if another program
                            on your PC already uses it - the ALIGN tab keeps working either way.
                        </TextBlock>

                        <!-- ALIGN beeps: like a car's parking sensor. Own on/off, own volume and Test button, same layout as the
                             speed alerts. They only ever sound while the ALIGN window is open. -->
                        <CheckBox IsChecked="{Binding AlignBeepsEnabled}">
                            <TextBlock TextWrapping="Wrap" Text="Parking-sensor beeps while ALIGN is open" />
                        </CheckBox>
                        <StackPanel Style="{StaticResource VolumeRow}" IsEnabled="{Binding AlignBeepsEnabled}">
                            <TextBlock Text="Volume" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Slider Width="140" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    Value="{Binding AlignBeepVolume, Mode=TwoWay}" />
                            <TextBlock Text="{Binding AlignBeepVolumeLabel}" Foreground="#CCCCCC" FontSize="12"
                                       Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,10,0" />
                            <Button Content="Test" Command="{Binding PreviewAlignBeepsCommand}"
                                    Style="{StaticResource FlatTestButton}"
                                    ToolTip="Plays a short made-up approach so you can set the volume by ear" />
                        </StackPanel>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12">
                            Slow beeps that get faster as the kingpin gets closer (from about 5 m), then one steady tone when you
                            are at it. A higher pitch means you are lined up, a lower one that you are off line, and the sound
                            moves toward the side the kingpin is on. Going over 2 mph near the trailer gives a distinct two-tone
                            warning, and going past the hook gives rapid low beeps. They only sound while the truck is in a reverse
                            gear (not in neutral or a forward gear), stop when you stop, and only sound while the ALIGN window is
                            open. Volume 0 is silent.
                        </TextBlock>
                    </StackPanel>

                    <!-- UI Setup: units, which HUD components show, and the fatigue toggle (which is
                         really just "show/hide the rest timer", so it belongs alongside the other
                         display toggles). -->
                    <StackPanel Visibility="{Binding IsUiSetupTab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Units" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="{Binding UnitLabel}" Command="{Binding ToggleUnitCommand}" ToolTip="Speed unit" Width="60" />
                            <Button Content="{Binding WeightUnitLabel}" Command="{Binding ToggleWeightUnitCommand}" ToolTip="Cargo weight unit" Width="60" />
                            <Button Content="{Binding FuelUnitLabel}" Command="{Binding ToggleFuelUnitCommand}" ToolTip="Fuel / AdBlue unit" Width="60" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <!-- Display components -->
                        <TextBlock Text="Display components" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            Turn off anything you don't want cluttering the HUD - the window reflows to fit.
                        </TextBlock>

                        <CheckBox Content="Current speed" IsChecked="{Binding ShowSpeedSection}" />
                        <CheckBox Content="Odometer" IsChecked="{Binding ShowOdometer}" />
                        <CheckBox Content="Speed limit sign" IsChecked="{Binding ShowSpeedSign}" />
                        <CheckBox Content="In-game clock" IsChecked="{Binding ShowGameClock}" />
                        <CheckBox Content="Cruise control" IsChecked="{Binding ShowCruiseControl}" />
                        <CheckBox Content="Parking brake" IsChecked="{Binding ShowParkingBrake}" />
                        <CheckBox Content="Lights status (beams / sidelights / beacon)" IsChecked="{Binding ShowLightsStatus}" />
                        <CheckBox Content="Gear + RPM" IsChecked="{Binding ShowGearRpmSection}" />
                        <CheckBox Content="Route (source / destination)" IsChecked="{Binding ShowRoute}" />
                        <CheckBox Content="Cargo + weight" IsChecked="{Binding ShowCargo}" />
                        <CheckBox Content="Payout" IsChecked="{Binding ShowPayout}" />
                        <CheckBox Content="Distance" IsChecked="{Binding ShowDistance}" />
                        <CheckBox Content="Time left" IsChecked="{Binding ShowTimeLeft}" />
                        <CheckBox Content="Fuel" IsChecked="{Binding ShowFuelSection}" />
                        <CheckBox Content="Trip fuel forecast (Trip Needs)" IsChecked="{Binding ShowTripFuelForecast}" />
                        <CheckBox Content="Fuel economy (MPG / L per 100km)" IsChecked="{Binding ShowFuelEconomy}" />
                        <CheckBox Content="AdBlue" IsChecked="{Binding ShowAdBlue}" />
                        <CheckBox Content="Warning lights" IsChecked="{Binding ShowWarnings}" Margin="0,0,0,16" />

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <!-- Speed alerts: cues layered on the speed limit sign / speed colours -->
                        <TextBlock Text="Speed alerts" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            Quiet audio cues so you don't have to keep glancing at the speed. Each sound has its own switch and its own volume (0 = silent).
                        </TextBlock>
                        <!-- Two independent sounds, each with its own on/off, volume and Test button. Check box content is a
                             wrapping TextBlock (a plain string Content never wraps and ran off the window edge). -->
                        <CheckBox IsChecked="{Binding SpeedLimitChangeBeepEnabled}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Single beep when the speed limit changes (higher tone = limit up, lower tone = limit down)" />
                        </CheckBox>
                        <StackPanel Style="{StaticResource VolumeRow}" IsEnabled="{Binding SpeedLimitChangeBeepEnabled}">
                            <TextBlock Text="Volume" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Slider Width="140" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    Value="{Binding SpeedLimitChangeBeepVolume, Mode=TwoWay}" />
                            <TextBlock Text="{Binding SpeedLimitChangeBeepVolumeLabel}" Foreground="#CCCCCC" FontSize="12"
                                       Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,10,0" />
                            <Button Content="Test" Command="{Binding PreviewLimitChangeBeepCommand}"
                                    Style="{StaticResource FlatTestButton}"
                                    ToolTip="Plays the limit-up beep, then the limit-down beep" />
                        </StackPanel>

                        <CheckBox IsChecked="{Binding OverLimitBeepEnabled}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Double beep when the speed turns red (more than 5 over the limit)" />
                        </CheckBox>
                        <StackPanel Style="{StaticResource VolumeRow}" IsEnabled="{Binding OverLimitBeepEnabled}"
                                    Margin="20,2,0,16">
                            <TextBlock Text="Volume" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Slider Width="140" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    Value="{Binding OverLimitBeepVolume, Mode=TwoWay}" />
                            <TextBlock Text="{Binding OverLimitBeepVolumeLabel}" Foreground="#CCCCCC" FontSize="12"
                                       Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,10,0" />
                            <Button Content="Test" Command="{Binding PreviewBeepCommand}"
                                    Style="{StaticResource FlatTestButton}"
                                    ToolTip="Plays the over-limit double beep" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

                        <!-- Fatigue simulation -->
                        <TextBlock Text="Fatigue simulation" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            The game reports the same value whether this is off or just hasn't counted down yet, so TruckHub can't detect it automatically - tell it here if you have it enabled.
                        </TextBlock>
                        <CheckBox Content="I have fatigue simulation enabled in-game" IsChecked="{Binding FatigueSimulationEnabled}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right"
                Click="Close_Click" Margin="0,10,16,10" />
    </Grid>
</Window>
