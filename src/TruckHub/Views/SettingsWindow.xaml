<Window x:Class="TruckHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="TruckHub Settings"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#161616">

    <Window.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Width" Value="50" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Units" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="{Binding UnitLabel}" Command="{Binding ToggleUnitCommand}" ToolTip="Speed unit" Width="60" />
            <Button Content="{Binding WeightUnitLabel}" Command="{Binding ToggleWeightUnitCommand}" ToolTip="Cargo weight unit" Width="60" />
            <Button Content="{Binding FuelUnitLabel}" Command="{Binding ToggleFuelUnitCommand}" ToolTip="Fuel / AdBlue unit" Width="60" />
        </StackPanel>

        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

        <TextBlock Text="Game install locations" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
            TruckHub auto-detects Steam installs. If a game isn't found - a non-Steam copy, or a
            library drive Steam can't see right now - point it at the install folder manually.
        </TextBlock>

        <!-- ETS2 -->
        <TextBlock Text="Euro Truck Simulator 2" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Ets2StatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                   Margin="0,2,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Browse..." Command="{Binding BrowseEts2Command}" />
            <Button Content="Clear override" Command="{Binding ClearEts2Command}"
                    Visibility="{Binding HasManualEts2Path, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ATS -->
        <TextBlock Text="American Truck Simulator" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding AtsStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                   Margin="0,2,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Browse..." Command="{Binding BrowseAtsCommand}" />
            <Button Content="Clear override" Command="{Binding ClearAtsCommand}"
                    Visibility="{Binding HasManualAtsPath, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

        <!-- Gearbox calibration -->
        <TextBlock Text="Gearbox calibration" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
            ATS resets your H-shifter to neutral the moment the game window loses focus, so tabbing
            in here to read the live gear doesn't work. Instead: while driving, with ATS still
            focused, shift into the gear you want and press <Run FontWeight="Bold" Foreground="White">Ctrl+Alt+G</Run>
            to capture it. Then come label it here whenever's convenient - Low/High range is
            automatic (just adds the L/H suffix); a splitter that remaps the same stick slots to
            different gears needs its own capture and Set below.
        </TextBlock>
        <TextBlock Text="{Binding GearboxStatusDisplay}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBlock Text="{Binding PendingCaptureDisplay}" Foreground="#7FB0FF" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsGearboxConnected, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding NormalGearNumberInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Set gear" Command="{Binding SetNormalGearCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding HasSplitter, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding SplitterGearNumberInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Set gear (splitter engaged)" Command="{Binding SetSplitterGearCommand}" />
        </StackPanel>

        <Button Content="Clear calibration" Command="{Binding ClearCalibrationCommand}"
                HorizontalAlignment="Left" Margin="0,0,0,16" />

        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16" />

        <!-- Display components -->
        <TextBlock Text="Display components" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
            Turn off anything you don't want cluttering the HUD - the window reflows to fit.
        </TextBlock>

        <CheckBox Content="Speed sign + current speed" IsChecked="{Binding ShowSpeedSection}" />
        <CheckBox Content="Cruise control" IsChecked="{Binding ShowCruiseControl}" />
        <CheckBox Content="Parking brake" IsChecked="{Binding ShowParkingBrake}" />
        <CheckBox Content="Lights status (beams / sidelights / beacon)" IsChecked="{Binding ShowLightsStatus}" />
        <CheckBox Content="Gear + RPM" IsChecked="{Binding ShowGearRpmSection}" />
        <CheckBox Content="Route (source / destination)" IsChecked="{Binding ShowRoute}" />
        <CheckBox Content="Cargo + weight" IsChecked="{Binding ShowCargo}" />
        <CheckBox Content="Payout" IsChecked="{Binding ShowPayout}" />
        <CheckBox Content="Distance" IsChecked="{Binding ShowDistance}" />
        <CheckBox Content="Time left" IsChecked="{Binding ShowTimeLeft}" />
        <CheckBox Content="Fuel" IsChecked="{Binding ShowFuelSection}" />
        <CheckBox Content="Trip fuel forecast (Trip Needs)" IsChecked="{Binding ShowTripFuelForecast}" />
        <CheckBox Content="Fuel economy (MPG / L per 100km)" IsChecked="{Binding ShowFuelEconomy}" />
        <CheckBox Content="AdBlue" IsChecked="{Binding ShowAdBlue}" />
        <CheckBox Content="Warning lights" IsChecked="{Binding ShowWarnings}" Margin="0,0,0,16" />

        <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click" />
    </StackPanel>
</Window>
