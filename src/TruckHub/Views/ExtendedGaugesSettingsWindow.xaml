<Window x:Class="TruckHub.Views.ExtendedGaugesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TruckHub - EXT Settings"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#161616">

    <!-- Same fixed-size WindowChrome treatment as the main SettingsWindow. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#202020" Height="28" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="TRUCKHUB · EXT SETTINGS" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

            <Button Grid.Column="1" Content="✕" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Width="28" Height="28" FontSize="10" Background="Transparent"
                    Foreground="White" BorderThickness="0" Margin="0" />
        </Grid>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Margin="16,12,16,0">
            <StackPanel Margin="16">
                <TextBlock Text="Display components" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                    Turn off anything you don't want cluttering this window - it reflows and rescales to fit whatever's left.
                </TextBlock>

                <CheckBox Content="Oil pressure gauge" IsChecked="{Binding ShowOilPressure}" />
                <CheckBox Content="Oil temperature gauge" IsChecked="{Binding ShowOilTemp}" />
                <CheckBox Content="Water temperature gauge" IsChecked="{Binding ShowWaterTemp}" />
                <CheckBox Content="Battery voltage gauge" IsChecked="{Binding ShowBattery}" />
                <CheckBox Content="Brake air pressure gauge" IsChecked="{Binding ShowBrakeAir}" />
                <CheckBox Content="Brake temperature gauge" IsChecked="{Binding ShowBrakeTemp}" />
                <CheckBox Content="Suspension deflection (truck + trailer)" IsChecked="{Binding ShowSuspension}" />
                <CheckBox Content="Trailer axle status" IsChecked="{Binding ShowTrailerAxleStatus}" />
                <CheckBox Content="Accessory wear (truck + trailer)" IsChecked="{Binding ShowWear}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right"
                Click="Close_Click" Margin="0,10,16,10" />
    </Grid>
</Window>
