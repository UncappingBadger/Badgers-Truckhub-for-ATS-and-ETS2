<UserControl x:Class="TruckHub.Controls.OdometerDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="14" Height="20">

    <!-- One drum of a mechanical-style odometer. An earlier version tried a literal scrolling strip
         (stacked 0-9 shifted via a TranslateTransform, to mimic a real drum's continuous roll) but
         that turned out unreliable in practice - confirmed live it rendered blank or blended glyphs
         under real conditions that were never fully root-caused. This simpler, robust version just
         shows the correct digit as plain text and plays a brief colour-flash when it changes -
         reads clearly at a glance, "ticks" visibly on every increment, and has none of the
         transform/clipping fragility the strip version ran into. -->
    <Border Background="#0A0A0A">
        <TextBlock x:Name="DigitText" Text="0" TextAlignment="Center" VerticalAlignment="Center"
                   Foreground="White" FontFamily="Consolas" FontWeight="Bold" FontSize="14" />
    </Border>
</UserControl>
